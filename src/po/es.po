#: src/panelMenu.ts:73 src/panelMenu.ts:87
msgid "Play"
msgstr "Reproducir"

#: src/panelMenu.ts:94 src/panelMenu.ts:102
msgid "Unmute Audio"
msgstr "Activar audio"

#: src/panelMenu.ts:94 src/panelMenu.ts:102 src/prefs.ts:42
msgid "Mute Audio"
msgstr "Silenciar el audio"

#: src/panelMenu.ts:109
msgid "Next Wallpaper"
msgstr "Siguiente fondo de pantalla"

#: src/panelMenu.ts:126
msgid "Preferences"
msgstr "Preferencias"

#: src/prefs.ts:38
msgid "General"
msgstr "General"

#: src/prefs.ts:43
msgid "Volume Level"
msgstr "Nivel de volumen"

#: src/prefs.ts:44
msgid "Random Start Position"
msgstr "Posición de Inicio Aleatoria"

#: src/prefs.ts:45
msgid "Start playback from a random position each time a video starts"
msgstr ""
"Iniciar la reproducción desde una posición aleatoria cada vez que comience "
"un vídeo"

#: src/prefs.ts:46
msgid "Show Panel Menu"
msgstr "Mostrar menú del panel"

#: src/prefs.ts:47
msgid "Show on Lock Screen"
msgstr "Mostrar en la Pantalla de Bloqueo"

#: src/prefs.ts:48
msgid "Show the live wallpaper on the lock screen"
msgstr "Mostrar el fondo de pantalla animado en la pantalla de bloqueo"

#: src/prefs.ts:50
msgid "Auto Pause"
msgstr "Pausa automática"

#: src/prefs.ts:53
msgid "Pause on Window Focus"
msgstr "Pausar al enfocar la ventana"

#: src/prefs.ts:54
msgid "Pause playback when any window is focused"
msgstr "Pausar la reproducción cuando cualquier ventana tenga el foco"

#: src/prefs.ts:56
msgid "Low Battery Threshold"
msgstr "Límite de la batería baja"

#: src/prefs.ts:57
msgid "Set the threshold percentage for low battery level"
msgstr "Establece el porcentaje del umbral para el nivel bajo de batería"

#: src/prefs.ts:58
msgid "Pause on Media Player Playing"
msgstr "Pausa en la reproducción del reproductor multimedia"

#: src/prefs.ts:59
msgid "Pause playback when an MPRIS media player is playing media"
msgstr ""
"Pausar la reproducción cuando un reproductor multimedia MPRIS está "
"reproduciendo los medios"

#: src/prefs.ts:61
msgid "Wallpaper Changer"
msgstr "Cambiador del fondo de pantalla"

#: src/prefs.ts:63
msgid "Change Wallpaper Automatically"
msgstr "Cambiar el fondo de pantalla automáticamente"

#: src/prefs.ts:66
msgid "Change Wallpaper Interval (minutes)"
msgstr "Cambiar el intervalo del fondo de pantalla (minutos)"

#: src/prefs.ts:69
msgid "Overview"
msgstr "Vista general"

#: src/prefs.ts:71
msgid "Corner Radius"
msgstr "Radio de las esquinas"

#: src/prefs.ts:72
msgid ""
"Rounded corner radius in pixels for workspace background in the overview"
msgstr ""
"Radio de las esquinas redondeadas, en píxeles, del fondo del espacio de "
"trabajo en la vista general"

#: src/prefs.ts:74
msgid "Experimental"
msgstr "Experimental"

#: src/prefs.ts:76
msgid "Experimental VA Plugin"
msgstr "Complemento VA experimental"

#: src/prefs.ts:77
msgid ""
"Enable VA decoders which improve performance for Intel/AMD Wayland users"
msgstr ""
"Habilite los decodificadores VA que mejoran el rendimiento para los usuarios "
"de Intel/AMD Wayland"

#: src/prefs.ts:78
msgid "NVIDIA Stateless Decoders"
msgstr "Decodificadores sin estado NVIDIA"

#: src/prefs.ts:79
msgid "Use new stateless NVIDIA decoders"
msgstr "Utilice nuevos decodificadores NVIDIA sin estado"

#: src/prefs.ts:81
msgid "Developer"
msgstr "Desarrollador"

#: src/prefs.ts:83
msgid "Debug Mode"
msgstr "Modo de depuración"

#: src/prefs.ts:84
msgid "Print debug messages to log"
msgstr "Escribir mensajes de depuración en el registro."

#: src/prefs.ts:85
msgid "Prefer clappersink"
msgstr "Preferir Clappersink"

#: src/prefs.ts:86
msgid "Prefer clappersink over gtk4paintablesink for video playback"
msgstr ""
"Preferir Clappersink en lugar de gtk4paintablesink para reproducción de video"

#: src/prefs.ts:87
msgid "Force GtkMediaFile"
msgstr "Forzar el uso de GtkMediaFile"

#: src/prefs.ts:88
msgid "Force use of GtkMediaFile for video playback"
msgstr "Forzar el uso de GtkMediaFile para la reproducción de vídeo"

#: src/prefs.ts:89
msgid "Enable Graphics Offload"
msgstr "Activar la descarga de procesamiento gráfico"

#: src/prefs.ts:90
msgid "Enable graphics offload for improved performance"
msgstr ""
"Activar la descarga de procesamiento gráfico para mejorar el rendimiento"

#: src/prefs.ts:91
msgid "Startup Delay"
msgstr "Retraso del inicio"

#: src/prefs.ts:92
msgid ""
"Add a startup delay (in milliseconds) to mitigate compatibility issues with "
"other extensions"
msgstr ""
"Agregue un retraso de inicio (en milisegundos) para mitigar los problemas de "
"compatibilidad con otras extensiones"

#: src/prefs.ts:94
msgid "Border Stroke"
msgstr "Trazo del Borde"

#: src/prefs.ts:95
msgid ""
"Border width in pixels drawn inside the rounded-rect bounds (0 = disabled)"
msgstr ""
"Ancho del borde en píxeles, dibujado dentro de los límites del rectángulo "
"redondeado (0 = desactivado)"

#: src/prefs.ts:160
msgid "Video Path"
msgstr "Ruta del vídeo"

#: src/prefs.ts:166 src/prefs.ts:191 src/prefs.ts:207 src/prefs.ts:228
msgid "None"
msgstr "Ninguno"

#: src/prefs.ts:172 src/prefs.ts:213
msgid "Open"
msgstr "Abrir"

#: src/prefs.ts:182
msgid "Open File"
msgstr "Abrir documento"

#: src/prefs.ts:201
msgid "Change Wallpaper Directory Path"
msgstr "Cambiar la ruta del directorio de la imagen de fondo"

#: src/prefs.ts:220
msgid "Select Directory"
msgstr "Seleccionar directorio"

#: src/prefs.ts:238
msgid "Fit Mode"
msgstr "Modo de ajuste"

#: src/prefs.ts:239
msgid "Control how wallpaper fits within the monitor"
msgstr "Controla cómo encaja el fondo de pantalla en el monitor"

#: src/prefs.ts:240
msgid ""
"\n"
"    <b>Fill</b>: Stretch the wallpaper to fill the monitor.\n"
"    <b>Contain</b>: Scale the wallpaper to fit the monitor (keep aspect "
"ratio).\n"
"    <b>Cover</b>: Scale the wallpaper to cover the monitor (keep aspect "
"ratio).\n"
"    <b>Scale-down</b>: Scale down the wallpaper to fit the monitor if "
"needed, otherwise keep its original size.\n"
"    "
msgstr ""
"\n"
"    <b>Relleno</b>: Estira el fondo de pantalla para llenar el monitor.\n"
"    <b>Contener</b>: Escala el fondo de pantalla para que se ajuste al "
"monitor (mantén la relación de aspecto).\n"
"    <b>Cubierta</b>: Escala el fondo de pantalla para cubrir el monitor "
"(mantén la relación de aspecto).\n"
"    <b>Reducción de escala</b>: Reduzca la escala del fondo de pantalla para "
"que se ajuste al monitor si es necesario, de lo contrario, mantenga su "
"tamaño original.\n"
"    "

#: src/prefs.ts:248
msgid "Fill"
msgstr "Llenar"

#: src/prefs.ts:249
msgid "Contain"
msgstr "Contener"

#: src/prefs.ts:250
msgid "Cover"
msgstr "Cubrir"

#: src/prefs.ts:251
msgid "Scale-down"
msgstr "Reducir escala"

#: src/prefs.ts:274
msgid "Pause on Maximize or Fullscreen"
msgstr "Pausa en maximizar o pantalla completa"

#: src/prefs.ts:275
msgid "Pause playback when there is maximized or fullscreen window"
msgstr ""
"Pausa la reproducción cuando hay una ventana maximizada o a pantalla completa"

#: src/prefs.ts:276
msgid ""
"\n"
"    <b>Never</b>: Disable this feature.\n"
"    <b>Any Monitor</b>: Pause playback when there is maximized or fullscreen "
"window on any monitor.\n"
"    <b>All Monitors</b>: Pause playback when there are maximized or "
"fullscreen windows on all monitors.\n"
"    "
msgstr ""
"\n"
"    <b>Nunca</b>: deshabilita esta función.\n"
"    <b>Cualquier monitor</b>: pausa la reproducción cuando haya una ventana "
"maximizada o de pantalla completa en cualquier monitor.\n"
"    <b>Todos los monitores</b>: pausa la reproducción cuando haya ventanas "
"maximizadas o de pantalla completa en todos los monitores.\n"
"    "

#: src/prefs.ts:282 src/prefs.ts:309
msgid "Never"
msgstr "Nunca"

#: src/prefs.ts:282
msgid "Any Monitor"
msgstr "Cualquier monitor"

#: src/prefs.ts:282
msgid "All Monitors"
msgstr "Todos los monitores"

#: src/prefs.ts:301
msgid "Pause on Battery"
msgstr "Pausa en la batería"

#: src/prefs.ts:302
msgid "Pause playback when the device is on battery or the battery is low"
msgstr ""
"Pausa la reproducción cuando el dispositivo está con batería o la batería "
"está baja"

#: src/prefs.ts:303
msgid ""
"\n"
"    <b>Never</b>: Disable this feature.\n"
"    <b>Low Battery</b>: Pause playback when the device is on low battery "
"(below the threshold).\n"
"    <b>Always</b>: Pause playback when the device is on battery.\n"
"    "
msgstr ""
"\n"
"    <b>Nunca</b>: deshabilita esta función.\n"
"    <b>Batería baja</b>: pausa la reproducción cuando el dispositivo tiene "
"poca batería (por debajo del umbral).\n"
"    <b>Siempre</b>: pausa la reproducción cuando el dispositivo tiene "
"batería.\n"
"    "

#: src/prefs.ts:309
msgid "Low Battery"
msgstr "Batería baja"

#: src/prefs.ts:309
msgid "Always"
msgstr "Siempre"

#: src/prefs.ts:331
msgid "Change Wallpaper Mode"
msgstr "Cambiar el modo de fondo de pantalla"

#: src/prefs.ts:332
msgid "Control how to change wallpapers automatically"
msgstr "Controla cómo cambiar los fondos de pantalla automáticamente"

#: src/prefs.ts:333
msgid ""
"\n"
"    <b>Sequential:</b> Preserve the directory sequence (descending order).\n"
"    <b>Inverse Sequential:</b> Retrieve wallpapers in the opposite sequence "
"(ascending order).\n"
"    <b>Random:</b> Randomly select wallpapers from the directory.\n"
"    "
msgstr ""
"\n"
"    <b>Secuencial:</b> Conserve la secuencia de directorios (orden "
"descendente).\n"
"    <b>Secuencial inverso:</b> Recupere fondos de pantalla en la secuencia "
"opuesta (orden ascendente).\n"
"    <b>Aleatorio:</b> Seleccione fondos de pantalla al azar del directorio.\n"
"    "

#: src/prefs.ts:339
msgid "Sequential"
msgstr "Secuencial"

#: src/prefs.ts:339
msgid "Inverse Sequential"
msgstr "Secuencial inverso"

#: src/prefs.ts:339
msgid "Random"
msgstr "Aleatorio"

