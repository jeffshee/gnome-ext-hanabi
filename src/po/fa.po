msgid "Any Monitor"
msgstr "هر صفحه نمایشی"

#: src/prefs.ts:282
msgid "All Monitors"
msgstr "تمام صفحه نمایش‌ها"

#: src/prefs.ts:301
msgid "Pause on Battery"
msgstr ""

#: src/prefs.ts:302
msgid "Pause playback when the device is on battery or the battery is low"
msgstr ""

#: src/prefs.ts:303
msgid ""
"\n"
"    <b>Never</b>: Disable this feature.\n"
"    <b>Low Battery</b>: Pause playback when the device is on low battery "
"(below the threshold).\n"
"    <b>Always</b>: Pause playback when the device is on battery.\n"
"    "
msgstr ""
"\n"
"    <b>هرگز</b>: غیرفعال کردن این امکان.\n"
"    <b>سطح پایین باتری</b>: پخش تصویر رو در صورت کم بودن باتری دستگاه متوقف "
"کن(کمتر از استانه مشخص شده).\n"
"    <b>همیشه</b>: پخش تصویر رو در صورت استفاده از باتری دستگاه متوقف کن.\n"
"    "

#: src/prefs.ts:309
msgid "Low Battery"
msgstr ""

#: src/prefs.ts:309
msgid "Always"
msgstr "همیشه"

#: src/prefs.ts:331
msgid "Change Wallpaper Mode"
msgstr ""

#: src/prefs.ts:332
msgid "Control how to change wallpapers automatically"
msgstr ""

#: src/prefs.ts:333
msgid ""
"\n"
"    <b>Sequential:</b> Preserve the directory sequence (descending order).\n"
"    <b>Inverse Sequential:</b> Retrieve wallpapers in the opposite sequence "
"(ascending order).\n"
"    <b>Random:</b> Randomly select wallpapers from the directory.\n"
"    "
msgstr ""
"\n"
"    <b>نمایش پشت سر هم:</b> محتویات پوشه را پشت سر هم نشان بده(به ترتیب "
"نزولی).\n"
"    <b>نمایش برعکس:</b>  محتویات پوشه را پشت سر هم نشان بده(به ترتیب "
"صعودی).\n"
"    <b>تصادفی:</b> محتویات پوشه را تصادفی هم نشان بده.\n"
"    "

