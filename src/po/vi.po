#: src/prefs.ts:38
msgid "General"
msgstr "Chung"

#: src/prefs.ts:43
msgid "Volume Level"
msgstr "Mức âm lượng"

#: src/prefs.ts:44
msgid "Random Start Position"
msgstr "Vị trí bắt đầu ngẫu nhiên"

#: src/prefs.ts:45
msgid "Start playback from a random position each time a video starts"
msgstr "Bắt đầu phát từ một vị trí ngẫu nhiên mỗi khi video chạy"

#: src/prefs.ts:46
msgid "Show Panel Menu"
msgstr "Hiện menu thanh trên"

#: src/prefs.ts:47
msgid "Show on Lock Screen"
msgstr "Hiện trên màn hình khóa"

#: src/prefs.ts:48
msgid "Show the live wallpaper on the lock screen"
msgstr "Hiện hình nền động trên màn hình khóa"

#: src/prefs.ts:50
msgid "Auto Pause"
msgstr "Tự động tạm dừng"

#: src/prefs.ts:53
msgid "Pause on Window Focus"
msgstr "Tạm dừng khi cửa sổ được chọn"

#: src/prefs.ts:54
msgid "Pause playback when any window is focused"
msgstr "Tạm dừng phát khi có bất kỳ cửa sổ nào được chọn"

#: src/prefs.ts:56
msgid "Low Battery Threshold"
msgstr "Ngưỡng pin yếu"

#: src/prefs.ts:57
msgid "Set the threshold percentage for low battery level"
msgstr "Đặt phần trăm ngưỡng cho mức pin yếu"

#: src/prefs.ts:58
msgid "Pause on Media Player Playing"
msgstr "Tạm dừng khi trình phát đa phương tiện đang chạy"

#: src/prefs.ts:59
msgid "Pause playback when an MPRIS media player is playing media"
msgstr "Tạm dừng phát khi trình phát đa phương tiện MPRIS đang phát nội dung"

#: src/prefs.ts:61
msgid "Wallpaper Changer"
msgstr "Trình đổi hình nền"

#: src/prefs.ts:63
msgid "Change Wallpaper Automatically"
msgstr "Tự động đổi hình nền"

#: src/prefs.ts:66
msgid "Change Wallpaper Interval (minutes)"
msgstr "Khoảng thời gian đổi hình nền (phút)"

#: src/prefs.ts:69
msgid "Overview"
msgstr "Tổng quan"

#: src/prefs.ts:71
msgid "Corner Radius"
msgstr "Bán kính góc bo"

#: src/prefs.ts:72
msgid ""
"Rounded corner radius in pixels for workspace background in the overview"
msgstr ""
"Bán kính góc bo tròn tính bằng pixel cho nền không gian làm việc trong chế "
"độ tổng quan"

#: src/prefs.ts:74
msgid "Experimental"
msgstr "Thử nghiệm"

#: src/prefs.ts:76
msgid "Experimental VA Plugin"
msgstr "Plugin VA thử nghiệm"

#: src/prefs.ts:77
msgid ""
"Enable VA decoders which improve performance for Intel/AMD Wayland users"
msgstr ""
"Bật bộ giải mã VA giúp cải thiện hiệu suất cho người dùng Intel/AMD trên "
"Wayland"

#: src/prefs.ts:78
msgid "NVIDIA Stateless Decoders"
msgstr ""

#: src/prefs.ts:79
msgid "Use new stateless NVIDIA decoders"
msgstr "Sử dụng bộ giải mã không trạng thái NVIDIA mới"

#: src/prefs.ts:81
msgid "Developer"
msgstr "Lập trình viên"

#: src/prefs.ts:83
msgid "Debug Mode"
msgstr "Chế độ gỡ lỗi"

#: src/prefs.ts:84
msgid "Print debug messages to log"
msgstr "In thông điệp gỡ lỗi vào nhật ký"

#: src/prefs.ts:85
msgid "Prefer clappersink"
msgstr "Ưu tiên clappersink"

#: src/prefs.ts:86
msgid "Prefer clappersink over gtk4paintablesink for video playback"
msgstr "Ưu tiên clappersink hơn gtk4paintablesink để phát video"

#: src/prefs.ts:87
msgid "Force GtkMediaFile"
msgstr "Buộc dùng GtkMediaFile"

#: src/prefs.ts:88
msgid "Force use of GtkMediaFile for video playback"
msgstr "Buộc sử dụng GtkMediaFile để phát video"

#: src/prefs.ts:89
msgid "Enable Graphics Offload"
msgstr "Bật giảm tải đồ họa"

#: src/prefs.ts:90
msgid "Enable graphics offload for improved performance"
msgstr "Bật giảm tải đồ họa để cải thiện hiệu suất"

#: src/prefs.ts:91
msgid "Startup Delay"
msgstr "Độ trễ khởi động"

#: src/prefs.ts:92
msgid ""
"Add a startup delay (in milliseconds) to mitigate compatibility issues with "
"other extensions"
msgstr ""
"Thêm độ trễ khởi động (tính bằng mili-giây) để giảm thiểu các vấn đề tương "
"thích với các phần mở rộng khác"

#: src/prefs.ts:94
msgid "Border Stroke"
msgstr "Độ dày viền"

#: src/prefs.ts:95
msgid ""
"Border width in pixels drawn inside the rounded-rect bounds (0 = disabled)"
msgstr ""
"Độ rộng viền tính bằng pixel được vẽ bên trong giới hạn hình chữ nhật bo "
"tròn (0 = tắt)"

#: src/prefs.ts:160
msgid "Video Path"
msgstr "Đường dẫn video"

#: src/prefs.ts:166 src/prefs.ts:191 src/prefs.ts:207 src/prefs.ts:228
msgid "None"
msgstr "Không"

#: src/prefs.ts:172 src/prefs.ts:213
msgid "Open"
msgstr "Mở"

#: src/prefs.ts:182
msgid "Open File"
msgstr "Mở tập tin"

#: src/prefs.ts:201
msgid "Change Wallpaper Directory Path"
msgstr "Đổi đường dẫn thư mục hình nền"

#: src/prefs.ts:220
msgid "Select Directory"
msgstr "Chọn thư mục"

#: src/prefs.ts:238
msgid "Fit Mode"
msgstr ""

#: src/prefs.ts:239
msgid "Control how wallpaper fits within the monitor"
msgstr "Điều khiển cách hình nền hiển thị vừa vặn trên màn hình"

#: src/prefs.ts:240
msgid ""
"\n"
"    <b>Fill</b>: Stretch the wallpaper to fill the monitor.\n"
"    <b>Contain</b>: Scale the wallpaper to fit the monitor (keep aspect "
"ratio).\n"
"    <b>Cover</b>: Scale the wallpaper to cover the monitor (keep aspect "
"ratio).\n"
"    <b>Scale-down</b>: Scale down the wallpaper to fit the monitor if "
"needed, otherwise keep its original size.\n"
"    "
msgstr ""
"\n"
"    <b>Lấp đầy</b>: Kéo giãn hình nền để lấp đầy màn hình.\n"
"    <b>Chứa</b>: Co giãn hình nền cho vừa màn hình (giữ nguyên tỷ lệ khung "
"hình).\n"
"    <b>Phủ kín</b>: Co giãn hình nền để phủ kín màn hình (giữ nguyên tỷ lệ "
"khung hình).\n"
"    <b>Thu nhỏ</b>: Thu nhỏ hình nền cho vừa màn hình nếu cần, nếu không thì "
"giữ nguyên kích thước gốc.\n"
"    "

#: src/prefs.ts:248
msgid "Fill"
msgstr "Lấp đầy"

#: src/prefs.ts:249
msgid "Contain"
msgstr "Chứa"

#: src/prefs.ts:250
msgid "Cover"
msgstr "Phủ kín"

#: src/prefs.ts:251
msgid "Scale-down"
msgstr "Thu nhỏ"

#: src/prefs.ts:274
msgid "Pause on Maximize or Fullscreen"
msgstr "Tạm dừng khi phóng to hoặc toàn màn hình"

#: src/prefs.ts:275
msgid "Pause playback when there is maximized or fullscreen window"
msgstr "Tạm dừng phát khi có cửa sổ được phóng to hoặc ở chế độ toàn màn hình"

#: src/prefs.ts:276
msgid ""
"\n"
"    <b>Never</b>: Disable this feature.\n"
"    <b>Any Monitor</b>: Pause playback when there is maximized or fullscreen "
"window on any monitor.\n"
"    <b>All Monitors</b>: Pause playback when there are maximized or "
"fullscreen windows on all monitors.\n"
"    "
msgstr ""
"\n"
"    <b>Không bao giờ</b>: Vô hiệu hóa tính năng này.\n"
"    <b>Bất kỳ màn hình nào</b>: Tạm dừng phát khi có cửa sổ phóng to hoặc "
"toàn màn hình trên bất kỳ màn hình nào.\n"
"    <b>Tất cả màn hình</b>: Tạm dừng phát khi có cửa sổ phóng to hoặc toàn "
"màn hình trên tất cả các màn hình.\n"
"    "

#: src/prefs.ts:282 src/prefs.ts:309
msgid "Never"
msgstr "Không bao giờ"

#: src/prefs.ts:282
msgid "Any Monitor"
msgstr "Bất kỳ màn hình nào"

#: src/prefs.ts:282
msgid "All Monitors"
msgstr "Tất cả màn hình"

#: src/prefs.ts:301
msgid "Pause on Battery"
msgstr "Tạm dừng khi dùng pin"

#: src/prefs.ts:302
msgid "Pause playback when the device is on battery or the battery is low"
msgstr "Tạm dừng phát khi thiết bị đang sử dụng pin hoặc khi pin yếu"

#: src/prefs.ts:303
msgid ""
"\n"
"    <b>Never</b>: Disable this feature.\n"
"    <b>Low Battery</b>: Pause playback when the device is on low battery "
"(below the threshold).\n"
"    <b>Always</b>: Pause playback when the device is on battery.\n"
"    "
msgstr ""
"\n"
"    <b>Không bao giờ</b>: Vô hiệu hóa tính năng này.\n"
"    <b>Pin yếu</b>: Tạm dừng phát khi thiết bị sắp hết pin (dưới ngưỡng cài "
"đặt).\n"
"    <b>Luôn luôn</b>: Tạm dừng phát khi thiết bị đang dùng pin.\n"
"    "

#: src/prefs.ts:309
msgid "Low Battery"
msgstr "Pin yếu"

#: src/prefs.ts:309
msgid "Always"
msgstr "Luôn luôn"

#: src/prefs.ts:331
msgid "Change Wallpaper Mode"
msgstr "Đổi chế độ hình nền"

#: src/prefs.ts:332
msgid "Control how to change wallpapers automatically"
msgstr "Điều khiển cách thức thay đổi hình nền tự động"

#: src/prefs.ts:333
msgid ""
"\n"
"    <b>Sequential:</b> Preserve the directory sequence (descending order).\n"
"    <b>Inverse Sequential:</b> Retrieve wallpapers in the opposite sequence "
"(ascending order).\n"
"    <b>Random:</b> Randomly select wallpapers from the directory.\n"
"    "
msgstr ""
"\n"
"    <b>Tuần tự:</b> Giữ nguyên thứ tự trong thư mục (thứ tự giảm dần).\n"
"    <b>Tuần tự đảo ngược:</b> Lấy hình nền theo thứ tự ngược lại (thứ tự "
"tăng dần).\n"
"    <b>Ngẫu nhiên:</b> Chọn hình nền ngẫu nhiên từ thư mục.\n"
"    "

#: src/prefs.ts:339
msgid "Sequential"
msgstr "Tuần tự"

#: src/prefs.ts:339
msgid "Inverse Sequential"
msgstr "Tuần tự đảo ngược"

#: src/prefs.ts:339
msgid "Random"
msgstr "Ngẫu nhiên"
