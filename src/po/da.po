#: src/prefs.ts:238
msgid "Fit Mode"
msgstr ""

#: src/prefs.ts:239
msgid "Control how wallpaper fits within the monitor"
msgstr "Kontroller hvordan baggrunde passer til skærmen"

#: src/prefs.ts:240
msgid ""
"\n"
"    <b>Fill</b>: Stretch the wallpaper to fill the monitor.\n"
"    <b>Contain</b>: Scale the wallpaper to fit the monitor (keep aspect "
"ratio).\n"
"    <b>Cover</b>: Scale the wallpaper to cover the monitor (keep aspect "
"ratio).\n"
"    <b>Scale-down</b>: Scale down the wallpaper to fit the monitor if "
"needed, otherwise keep its original size.\n"
"    "
msgstr ""
"\n"
"    <b>Fyld</b>: Stræk baggrunden til at fylde skærmen.\n"
"    <b>Indehold</b>: Skaler baggrunden for at passe ind på skærmen (behold "
"billedformat).\n"
"    <b>Dæk</b>: Skaler baggrunden til at dække skærmen (behold "
"billedformat).\n"
"    <b>Skaler ned</b>: Skaler baggrunden ned for at passe til skærmen hvis "
"nødvendigt, ellers behold den originale størrelse.\n"
"    "

#: src/prefs.ts:248
msgid "Fill"
msgstr "Fyld"

#: src/prefs.ts:249
msgid "Contain"
msgstr "Indholde"

#: src/prefs.ts:250
msgid "Cover"
msgstr "Dæk"

#: src/prefs.ts:251
msgid "Scale-down"
msgstr "Skaler-ned"

#: src/prefs.ts:274
msgid "Pause on Maximize or Fullscreen"
msgstr "Paus ved Maksimer eller Fuldskærm"

#: src/prefs.ts:275
msgid "Pause playback when there is maximized or fullscreen window"
msgstr "Paus afspilning når der er et maksimeret eller fuldskærmet vindue"

#: src/prefs.ts:276
msgid ""
"\n"
"    <b>Never</b>: Disable this feature.\n"
"    <b>Any Monitor</b>: Pause playback when there is maximized or fullscreen "
"window on any monitor.\n"
"    <b>All Monitors</b>: Pause playback when there are maximized or "
"fullscreen windows on all monitors.\n"
"    "
msgstr ""
"\n"
"    <b>Aldrig</b>: Deaktiver denne funktion.\n"
"    <b>Enhver skærm</b>: Paus afspilning når der er et maksimeret eller fuld-"
"skærms vindue på enhver skærm.\n"
"    <b>Alle skærme</b>: Paus afspilning når der er et maksimeret eller fuld-"
"skærms vindue på alle skærme.\n"
"    "

#: src/prefs.ts:282 src/prefs.ts:309
msgid "Never"
msgstr "Aldrig"

#: src/prefs.ts:282
msgid "Any Monitor"
msgstr "Enhver skærm"

#: src/prefs.ts:282
msgid "All Monitors"
msgstr "Alle skærme"

#: src/prefs.ts:301
msgid "Pause on Battery"
msgstr "Paus ved Batteri"

#: src/prefs.ts:302
msgid "Pause playback when the device is on battery or the battery is low"
msgstr "Paus afspilning når enheden er på batteri eller batteriet er lavt"

#: src/prefs.ts:303
msgid ""
"\n"
"    <b>Never</b>: Disable this feature.\n"
"    <b>Low Battery</b>: Pause playback when the device is on low battery "
"(below the threshold).\n"
"    <b>Always</b>: Pause playback when the device is on battery.\n"
"    "
msgstr ""
"\n"
"    <b>Aldrig</b>: Deaktiver denne funktion.\n"
"    <b>Lavt Batteri</b>: Paus afspilning når enheden er på lavt batteri "
"(under tærsklen).\n"
"    <b>Altid</b>: Paus afspilning når enheden er på batteri.\n"
"    "

#: src/prefs.ts:309
msgid "Low Battery"
msgstr "Lavt Batteri"

#: src/prefs.ts:309
msgid "Always"
msgstr "Altid"

#: src/prefs.ts:331
msgid "Change Wallpaper Mode"
msgstr "Ændr Baggrunds Tilstand"

#: src/prefs.ts:332
msgid "Control how to change wallpapers automatically"
msgstr "Kontroller hvordan baggrunde skiftes automatisk"

#: src/prefs.ts:333
msgid ""
"\n"
"    <b>Sequential:</b> Preserve the directory sequence (descending order).\n"
"    <b>Inverse Sequential:</b> Retrieve wallpapers in the opposite sequence "
"(ascending order).\n"
"    <b>Random:</b> Randomly select wallpapers from the directory.\n"
"    "
msgstr ""
"\n"
"    <b>Normal rækkefølge:</b> Behold mappe rækkefølge (faldende "
"rækkefølge).\n"
"    <b>Modsat rækkefølge:</b> Hent baggrunde i modsat rækkefølge (stigende "
"rækkefølge).\n"
"    <b>Tilfældig:</b> Vælg baggrunde fra mappen i tilfældig rækkefølge.\n"
"    "

#: src/prefs.ts:339
msgid "Sequential"
msgstr "Normal rækkefølge"

#: src/prefs.ts:339
msgid "Inverse Sequential"
msgstr "Modsat Rækkefølge"

#: src/prefs.ts:339
msgid "Random"
msgstr "Tilfældig"

