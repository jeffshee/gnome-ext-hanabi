#: src/prefs.ts:238
msgid "Fit Mode"
msgstr "Режим заповнення"

#: src/prefs.ts:239
msgid "Control how wallpaper fits within the monitor"
msgstr "Керує як саме шпалери будуть вміщатися у моніторі"

#: src/prefs.ts:240
msgid ""
"\n"
"    <b>Fill</b>: Stretch the wallpaper to fill the monitor.\n"
"    <b>Contain</b>: Scale the wallpaper to fit the monitor (keep aspect "
"ratio).\n"
"    <b>Cover</b>: Scale the wallpaper to cover the monitor (keep aspect "
"ratio).\n"
"    <b>Scale-down</b>: Scale down the wallpaper to fit the monitor if "
"needed, otherwise keep its original size.\n"
"    "
msgstr ""
"\n"
"    <b>Заповнювати</b>: Розтягувати шпалери щоб заповнити монітор.\n"
"    <b>Утримувати</b>: Масштабувати шпалери щоб заповнити монітор (зі "
"збереженням співвідношення сторін).\n"
"    <b>Накладати</b>: Масштабувати шпалери щоб покрити монітор (зі "
"збереженням співвідношення сторін).\n"
"    <b>Зменшити масштаб</b>: Зменшити масштаб шпалер щоб заповнити монітор "
"(якщо масштабування потребується), в іншому випадку використовувати "
"оригінальний розмір.\n"
"    "

#: src/prefs.ts:248
msgid "Fill"
msgstr "Заповнювати"

#: src/prefs.ts:249
msgid "Contain"
msgstr "Утримувати"

#: src/prefs.ts:250
msgid "Cover"
msgstr "Накладати"

#: src/prefs.ts:251
msgid "Scale-down"
msgstr "Зменшити масштаб"

#: src/prefs.ts:274
msgid "Pause on Maximize or Fullscreen"
msgstr "Пауза на повноекранному режимі"

#: src/prefs.ts:275
msgid "Pause playback when there is maximized or fullscreen window"
msgstr "Призупинити відтворення при розгорнутому або повноекранному вікні"

#: src/prefs.ts:276
msgid ""
"\n"
"    <b>Never</b>: Disable this feature.\n"
"    <b>Any Monitor</b>: Pause playback when there is maximized or fullscreen "
"window on any monitor.\n"
"    <b>All Monitors</b>: Pause playback when there are maximized or "
"fullscreen windows on all monitors.\n"
"    "
msgstr ""
"\n"
"    <b>Ніколи</b>: Вимкнути дану функцію.\n"
"    <b>Будь-який монітор</b>: Призупинити відтворення, коли вікно розгорнуто "
"на весь екран або на весь екран на будь-якому моніторі.\n"
"    <b>Всі монітори</b>: Призупинити відтворення, коли на всіх моніторах "
"розгорнуті вікна на весь екран або в повноекранному режимі.\n"
"    "

#: src/prefs.ts:282 src/prefs.ts:309
msgid "Never"
msgstr "Ніколи"

#: src/prefs.ts:282
msgid "Any Monitor"
msgstr "Будь-який монітор"

#: src/prefs.ts:282
msgid "All Monitors"
msgstr "Всі монітори"

#: src/prefs.ts:301
msgid "Pause on Battery"
msgstr "Пауза на акумуляторі"

#: src/prefs.ts:302
msgid "Pause playback when the device is on battery or the battery is low"
msgstr ""
"Призупинення відтворення, коли пристрій працює від акумулятора або "
"акумулятор розряджений"

#: src/prefs.ts:303
msgid ""
"\n"
"    <b>Never</b>: Disable this feature.\n"
"    <b>Low Battery</b>: Pause playback when the device is on low battery "
"(below the threshold).\n"
"    <b>Always</b>: Pause playback when the device is on battery.\n"
"    "
msgstr ""
"\n"
"    <b>Ніколи</b>: Вимкнути дану функцію.\n"
"    <b>Низький рівень заряду акумулятора</b>: Призупинити відтворення, коли "
"пристрій має низький рівень заряду акумулятора (нижче порогового значення).\n"
"    <b>Завжди</b>: Призупинити відтворення, коли пристрій працює від "
"акумулятора.\n"
"    "

#: src/prefs.ts:309
msgid "Low Battery"
msgstr "Низький рівень заряду акумулятора"

#: src/prefs.ts:309
msgid "Always"
msgstr "Завжди"

#: src/prefs.ts:331
msgid "Change Wallpaper Mode"
msgstr "Зміна режиму шпалер"

#: src/prefs.ts:332
msgid "Control how to change wallpapers automatically"
msgstr "Керуйте автоматичною зміною шпалер"

#: src/prefs.ts:333
msgid ""
"\n"
"    <b>Sequential:</b> Preserve the directory sequence (descending order).\n"
"    <b>Inverse Sequential:</b> Retrieve wallpapers in the opposite sequence "
"(ascending order).\n"
"    <b>Random:</b> Randomly select wallpapers from the directory.\n"
"    "
msgstr ""
"\n"
"    <b>Послідовний:</b> Зберегти послідовність каталогів (за спаданням).\n"
"    <b>Зворотна послідовність:</b> Отримати шпалери у зворотній "
"послідовності (за зростанням).\n"
"    <b>Випадково:</b> Випадковий вибір шпалер з каталогу.\n"
"    "

#: src/prefs.ts:339
msgid "Sequential"
msgstr "Послідовний"

#: src/prefs.ts:339
msgid "Inverse Sequential"
msgstr "Зворотна послідовність"

#: src/prefs.ts:339
msgid "Random"
msgstr "Випадково"

