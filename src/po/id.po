#: src/prefs.ts:44
msgid "Random Start Position"
msgstr "Posisi Awal Acak"

#: src/prefs.ts:45
msgid "Start playback from a random position each time a video starts"
msgstr "Mulai pemutaran dari posisi acak setiap kali video dimulai"

#: src/prefs.ts:46
